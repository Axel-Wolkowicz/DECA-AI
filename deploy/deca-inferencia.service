# Alternativa sin Docker: el servicio como unidad systemd sobre un venv. Ver DESPLIEGUE.md.
#
#   sudo cp deploy/deca-inferencia.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now deca-inferencia
#   journalctl -u deca-inferencia -f
#
# Supone el repo en /opt/deca-ai, el venv en /opt/deca-ai/.venv y un usuario de sistema
# "deca". El token va en /etc/deca-inferencia.env (una linea DECA_API_TOKEN=..., chmod 600).

[Unit]
Description=DECA - servicio de inferencia de ECG
After=network-online.target
Wants=network-online.target

[Service]
User=deca
Group=deca
WorkingDirectory=/opt/deca-ai/src
EnvironmentFile=/etc/deca-inferencia.env
# Solo loopback: lo publica el proxy o el tunel, nunca directo a la red.
ExecStart=/opt/deca-ai/.venv/bin/uvicorn servidor:app --host 127.0.0.1 --port 8000 --workers 1
Restart=on-failure
RestartSec=5

# El servicio no escribe a disco: lee el checkpoint y procesa todo en RAM.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
