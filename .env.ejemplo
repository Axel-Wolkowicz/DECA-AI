# Copiar a .env (que no se versiona) y completar. Lo lee compose.yaml.

# Secreto compartido con DECA-Back: el mismo valor va en DECA_API_TOKEN de Vercel.
# Generarlo con:  python -c "import secrets; print(secrets.token_urlsafe(32))"
DECA_API_TOKEN=

# Puerto local (solo 127.0.0.1) donde escucha el servicio. Cambiarlo si el 8000 esta ocupado.
DECA_PUERTO=8000

# Solo para la variante B (tunel). Lo da el panel de Cloudflare al crear el tunel.
CLOUDFLARE_TUNNEL_TOKEN=
